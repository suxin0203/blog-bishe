/* pages/about/index.wxss */
.page {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.content {
  height: 100vh;
  padding: 40rpx 30rpx;
}

/* 应用信息 */
.app-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  background-color: rgba(255, 255, 255, 0.95);
  border-radius: 32rpx;
  margin-bottom: 40rpx;
  backdrop-filter: blur(10rpx);
}

.app-logo {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.app-version {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.app-desc {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  line-height: 1.6;
}

/* 区块 */
.section {
  background-color: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  backdrop-filter: blur(10rpx);
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

/* 功能特性 */
.features-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 20rpx;
  background-color: #f8f9fa;
  border-radius: 16rpx;
}

.feature-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.feature-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.feature-desc {
  font-size: 24rpx;
  color: #999;
  text-align: center;
}

/* 联系方式 */
.contact-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.contact-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background-color: #f8f9fa;
  border-radius: 16rpx;
}

.contact-label {
  font-size: 28rpx;
  color: #666;
}

.contact-value {
  font-size: 26rpx;
  color: #667eea;
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 更新日志 */
.update-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.update-item {
  padding: 24rpx;
  background-color: #f8f9fa;
  border-radius: 16rpx;
}

.update-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.update-version {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.update-date {
  font-size: 24rpx;
  color: #999;
}

.update-items {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.update-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 版权信息 */
.copyright {
  text-align: center;
  padding: 60rpx 0 40rpx;
}

.copyright text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}
