/* pages/me/index.wxss */
.page {
  height: 100vh;
  background: #f6f7f9;
}

.content {
  height: 100%;
  padding: 32rpx;
}

/* 未登录状态 */
.login-prompt {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 80rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  margin-bottom: 32rpx;
}

.login-text {
  font-size: 28rpx;
  color: #6b7280;
  margin-bottom: 32rpx;
}

.login-btn {
  background: #18a058;
  color: #ffffff;
  border-radius: 48rpx;
  padding: 24rpx 80rpx;
  font-size: 28rpx;
  border: none;
}

/* 用户卡片 */
.user-card {
  background: linear-gradient(135deg, #18a058 0%, #0d7a3f 100%);
  border-radius: 32rpx;
  padding: 40rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(24, 160, 88, 0.3);
}

.user-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.avatar-text {
  font-size: 48rpx;
  font-weight: 600;
  color: #ffffff;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.username {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
}

.user-role {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  background: rgba(255, 255, 255, 0.2);
  padding: 6rpx 16rpx;
  border-radius: 24rpx;
  align-self: flex-start;
}

.user-stats {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding-top: 32rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 600;
  color: #ffffff;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.2);
}

/* 菜单列表 */
.menu-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
}

.menu-icon {
  font-size: 40rpx;
}

.menu-title {
  flex: 1;
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 500;
}

.menu-arrow {
  font-size: 48rpx;
  color: #d1d5db;
}

/* 退出登录 */
.logout-section {
  margin-bottom: 32rpx;
}

.logout-btn {
  width: 100%;
  background: #ffffff;
  color: #ef4444;
  border-radius: 24rpx;
  padding: 32rpx;
  font-size: 28rpx;
  border: none;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

/* 版本信息 */
.version-info {
  padding: 32rpx;
  text-align: center;
}

.version-text {
  font-size: 24rpx;
  color: #9ca3af;
}
