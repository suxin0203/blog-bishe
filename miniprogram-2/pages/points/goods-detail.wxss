/* pages/points/goods-detail.wxss */
.page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  color: #999;
}

.content {
  height: 100vh;
}

/* 商品图片 */
.goods-image {
  width: 100%;
  height: 500rpx;
  background-color: #fff;
}

.goods-image image {
  width: 100%;
  height: 100%;
}

/* 卡片样式 */
.card {
  background-color: #fff;
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 商品信息 */
.goods-info {
  margin-top: 0;
}

.goods-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.goods-name {
  flex: 1;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
}

.goods-type {
  margin-left: 20rpx;
  padding: 8rpx 16rpx;
  background-color: #e6f7ff;
  color: #1890ff;
  font-size: 24rpx;
  border-radius: 8rpx;
  white-space: nowrap;
}

.goods-points {
  display: flex;
  align-items: baseline;
  margin: 20rpx 0;
  padding: 20rpx 0;
  border-top: 1rpx solid #f0f0f0;
  border-bottom: 1rpx solid #f0f0f0;
}

.points-label {
  font-size: 28rpx;
  color: #666;
  margin-right: 20rpx;
}

.points-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #ff4d4f;
}

.points-value::after {
  content: ' 积分';
  font-size: 28rpx;
  font-weight: normal;
  color: #999;
}

.goods-stock {
  display: flex;
  align-items: center;
  margin: 20rpx 0;
}

.stock-label {
  font-size: 28rpx;
  color: #666;
}

.stock-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.goods-desc {
  margin-top: 20rpx;
}

.desc-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.desc-content {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  white-space: pre-wrap;
}

/* 用户积分 */
.user-points {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.user-points .label {
  font-size: 28rpx;
  color: #666;
}

.user-points .value {
  font-size: 36rpx;
  font-weight: bold;
  color: #52c41a;
}

/* 数量选择器 */
.quantity-selector {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.quantity-selector .label {
  font-size: 28rpx;
  color: #666;
}

.selector {
  display: flex;
  align-items: center;
}

.selector .btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  font-size: 32rpx;
  color: #333;
  user-select: none;
}

.selector .btn.disabled {
  color: #ccc;
}

.selector .input {
  width: 120rpx;
  height: 60rpx;
  text-align: center;
  font-size: 28rpx;
  margin: 0 20rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 8rpx;
}

/* 总计积分 */
.total-points {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.total-points .label {
  font-size: 28rpx;
  color: #666;
}

.total-points .value {
  font-size: 40rpx;
  font-weight: bold;
  color: #ff4d4f;
}

/* 备注 */
.remark .label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.remark .textarea {
  width: 100%;
  min-height: 150rpx;
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 底部占位 */
.bottom-placeholder {
  height: 120rpx;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: #fff;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.total-info {
  flex: 1;
  display: flex;
  align-items: baseline;
}

.total-info .label {
  font-size: 28rpx;
  color: #666;
  margin-right: 10rpx;
}

.total-info .value {
  font-size: 40rpx;
  font-weight: bold;
  color: #ff4d4f;
}

.total-info .unit {
  font-size: 24rpx;
  color: #999;
  margin-left: 8rpx;
}

.redeem-btn {
  width: 240rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 40rpx;
  border: none;
  padding: 0;
}

.redeem-btn::after {
  border: none;
}

/* 收货地址弹窗 */
.address-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  border-radius: 32rpx 32rpx 0 0;
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 40rpx;
  color: #999;
}

.modal-body {
  padding: 30rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.form-textarea {
  width: 100%;
  min-height: 150rpx;
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.modal-footer {
  display: flex;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.btn-cancel,
.btn-confirm {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 32rpx;
  border-radius: 40rpx;
  border: none;
  padding: 0;
}

.btn-cancel {
  background-color: #f5f5f5;
  color: #666;
  margin-right: 20rpx;
}

.btn-confirm {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.btn-cancel::after,
.btn-confirm::after {
  border: none;
}
