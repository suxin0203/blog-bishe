/* pages/article/list.wxss */
.page {
  height: 100vh;
  background: #f6f7f9;
}

.content {
  height: 100%;
  padding: 32rpx;
}

.article-list {
  margin-bottom: 32rpx;
}

.article-item {
  margin-bottom: 24rpx;
}

.article-with-cover {
  display: flex;
  gap: 24rpx;
}

.article-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.article-cover {
  width: 200rpx;
  height: 160rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.article-no-cover {
  display: flex;
  flex-direction: column;
}

.article-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  line-height: 1.5;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.article-summary {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.6;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.article-tags {
  margin-bottom: 16rpx;
}

.article-meta {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #9ca3af;
}

.meta-item {
  margin-right: 8rpx;
}

.meta-divider {
  margin-right: 8rpx;
}
