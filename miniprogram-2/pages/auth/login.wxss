/* pages/auth/login.wxss */
.page {
  height: 100vh;
  background: linear-gradient(135deg, #18a058 0%, #0d7a3f 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.container {
  width: 100%;
  padding: 64rpx 48rpx;
}

/* Logo 区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.logo {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 16rpx;
}

.app-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 登录区域 */
.login-section {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.wechat-login-btn {
  width: 100%;
  background: #ffffff;
  color: #18a058;
  border-radius: 48rpx;
  padding: 32rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.btn-icon {
  font-size: 40rpx;
}

.tips {
  margin-top: 32rpx;
  text-align: center;
}

.tip-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 表单区域 */
.form-section {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  box-sizing: border-box;
}

.form-header {
  position: relative;
  margin-bottom: 40rpx;
}

.back-btn {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  font-size: 28rpx;
  color: #18a058;
  padding: 8rpx 16rpx;
}

.form-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2937;
  text-align: center;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #f3f4f6;
  border-radius: 16rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  color: #1f2937;
  box-sizing: border-box;
}

.submit-btn {
  width: 100%;
  background: #18a058;
  color: #ffffff;
  border-radius: 48rpx;
  padding: 32rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  margin-top: 16rpx;
}

.switch-type {
  margin-top: 32rpx;
  text-align: center;
}

.switch-text {
  font-size: 26rpx;
  color: #18a058;
}

/* 验证码区域 */
.captcha-group {
  margin-bottom: 24rpx;
}

.captcha-question {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.captcha-text {
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 600;
}

.captcha-refresh {
  font-size: 26rpx;
  color: #18a058;
  padding: 8rpx 16rpx;
  border: 1rpx solid #18a058;
  border-radius: 8rpx;
}
