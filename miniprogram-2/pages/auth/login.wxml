<!--pages/auth/login.wxml-->
<view class="page">
  <view class="container">
    <!-- Logo -->
    <view class="logo-section">
      <view class="logo">📚</view>
      <text class="app-name">文栈博客</text>
      <text class="app-desc">技术分享 · 知识积累</text>
    </view>

    <!-- 微信登录 -->
    <view class="login-section" wx:if="{{loginType === 'wechat'}}">
      <button class="wechat-login-btn" bindtap="handleWechatLogin" loading="{{loading}}">
        <text class="btn-icon">🔐</text>
        <text class="btn-text">微信一键登录</text>
      </button>
      <view class="tips">
        <text class="tip-text">首次登录将自动创建账号</text>
      </view>
    </view>

    <!-- 注册新账号 -->
    <view class="form-section" wx:if="{{loginType === 'register'}}">
      <view class="form-header">
        <text class="back-btn" bindtap="backToWechat">← 返回</text>
        <view class="form-title">注册新账号</view>
      </view>
      <view class="form-group">
        <input class="form-input" placeholder="用户名（至少4个字符）" value="{{username}}" bindinput="onUsernameInput" maxlength="20" />
      </view>
      <view class="form-group">
        <input class="form-input" placeholder="密码（至少4个字符）" type="password" value="{{password}}" bindinput="onPasswordInput" maxlength="20" />
      </view>
      <view class="form-group">
        <input class="form-input" placeholder="邮箱（用于找回密码）" type="text" value="{{email}}" bindinput="onEmailInput" />
      </view>
      <view class="form-group captcha-group">
        <view class="captcha-question">
          <text class="captcha-text">{{captchaNum1}} + {{captchaNum2}} = ?</text>
          <text class="captcha-refresh" bindtap="getCaptcha">{{captchaLoading ? '...' : '刷新'}}</text>
        </view>
        <input class="form-input" placeholder="请输入验证码答案" type="number" value="{{captchaAnswer}}" bindinput="onCaptchaInput" />
      </view>
      <button class="submit-btn" bindtap="handleRegister" loading="{{loading}}">注册并绑定微信</button>
      <view class="switch-type">
        <text class="switch-text" bindtap="switchLoginType" data-type="bind">已有账号？去绑定</text>
      </view>
      <view class="tips">
        <text class="tip-text">注册后将自动绑定当前微信账号</text>
      </view>
    </view>

    <!-- 绑定已有账号 -->
    <view class="form-section" wx:if="{{loginType === 'bind'}}">
      <view class="form-header">
        <text class="back-btn" bindtap="backToWechat">← 返回</text>
        <view class="form-title">绑定已有账号</view>
      </view>
      <view class="form-group">
        <input class="form-input" placeholder="用户名（至少4个字符）" value="{{username}}" bindinput="onUsernameInput" maxlength="20" />
      </view>
      <view class="form-group">
        <input class="form-input" placeholder="密码（至少4个字符）" type="password" value="{{password}}" bindinput="onPasswordInput" maxlength="20" />
      </view>
      <view class="form-group captcha-group">
        <view class="captcha-question">
          <text class="captcha-text">{{captchaNum1}} + {{captchaNum2}} = ?</text>
          <text class="captcha-refresh" bindtap="getCaptcha">{{captchaLoading ? '...' : '刷新'}}</text>
        </view>
        <input class="form-input" placeholder="请输入验证码答案" type="number" value="{{captchaAnswer}}" bindinput="onCaptchaInput" />
      </view>
      <button class="submit-btn" bindtap="handleBind" loading="{{loading}}">登录并绑定微信</button>
      <view class="switch-type">
        <text class="switch-text" bindtap="switchLoginType" data-type="register">没有账号？去注册</text>
      </view>
      <view class="tips">
        <text class="tip-text">绑定后可使用微信一键登录</text>
      </view>
    </view>
  </view>
</view>
