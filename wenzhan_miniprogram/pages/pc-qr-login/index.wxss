/* pages/pc-qr-login/index.wxss */
.page {
  min-height: 100vh;
  background: #f6f7f9;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.confirm-page,
.success-page,
.loading-page {
  width: 100%;
  max-width: 620rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 64rpx 44rpx;
  box-sizing: border-box;
  text-align: center;
  box-shadow: 0 12rpx 36rpx rgba(15, 23, 42, 0.08);
}

.container {
  width: 100%;
}

.pc-icon,
.success-icon {
  width: 132rpx;
  height: 132rpx;
  margin: 0 auto 36rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
}

.pc-icon {
  background: #ecfdf5;
  color: #047857;
  font-size: 48rpx;
  letter-spacing: 2rpx;
}

.success-icon {
  background: #ecfdf5;
  color: #059669;
  font-size: 76rpx;
  border-radius: 50%;
}

.title,
.success-title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.35;
  margin-bottom: 16rpx;
}

.desc,
.success-desc {
  display: block;
  font-size: 27rpx;
  color: #6b7280;
  line-height: 1.6;
  margin-bottom: 48rpx;
}

.confirm-btn,
.cancel-btn {
  width: 100%;
  height: 104rpx;
  line-height: 104rpx;
  padding: 0;
  border-radius: 24rpx;
  border: none;
  font-size: 32rpx;
  font-weight: 700;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.confirm-btn {
  background: #059669;
  color: #ffffff;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(5, 150, 105, 0.18);
}

.confirm-btn:active {
  background: #047857;
}

.cancel-btn {
  background: #f3f4f6;
  color: #4b5563;
  margin-bottom: 36rpx;
}

.cancel-btn:active {
  background: #e5e7eb;
}

.auto-auth-section {
  margin-bottom: 28rpx;
}

.auto-auth-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx;
  background: #fafafa;
  border: 1rpx solid #eef0f3;
  border-radius: 24rpx;
}

.auto-auth-info {
  flex: 1;
  text-align: left;
  margin-right: 24rpx;
}

.auto-auth-title {
  display: block;
  font-size: 29rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 8rpx;
}

.auto-auth-desc {
  display: block;
  font-size: 24rpx;
  color: #9ca3af;
  line-height: 1.45;
}

.tips {
  padding: 0 12rpx;
}

.tip-text {
  display: block;
  font-size: 24rpx;
  color: #9ca3af;
  text-align: center;
  line-height: 1.6;
}

.loading-icon {
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto 32rpx;
  border: 6rpx solid #eef2f7;
  border-top-color: #059669;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  display: block;
  font-size: 30rpx;
  color: #6b7280;
  font-weight: 500;
}
