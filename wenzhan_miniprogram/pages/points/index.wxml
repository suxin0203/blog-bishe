<!--pages/points/index.wxml-->
<view class="page">
  <!-- 加载状态 -->
  <view class="loading-state" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 未登录状态 -->
  <view class="not-logged-in" wx:if="{{!loading && !isLoggedIn}}">
    <view class="login-prompt">
      <view class="prompt-icon">🎁</view>
      <text class="prompt-title">登录后查看积分</text>
      <text class="prompt-desc">登录即可获得积分奖励，兑换精美礼品</text>
      <button class="login-btn" bindtap="goToLogin">立即登录</button>
    </view>

    <!-- 积分规则说明 -->
    <view class="rules-preview">
      <view class="preview-header">
        <text class="preview-title">积分获取方式</text>
      </view>
      <view class="rule-items">
        <view class="rule-item">
          <view class="rule-icon">📅</view>
          <view class="rule-info">
            <text class="rule-name">每日登录</text>
            <text class="rule-points">+5 积分</text>
          </view>
        </view>
        <view class="rule-item">
          <view class="rule-icon">✍️</view>
          <view class="rule-info">
            <text class="rule-name">发布文章</text>
            <text class="rule-points">+10 积分</text>
          </view>
        </view>
        <view class="rule-item">
          <view class="rule-icon">💬</view>
          <view class="rule-info">
            <text class="rule-name">评论通过</text>
            <text class="rule-points">+5 积分</text>
          </view>
        </view>
        <view class="rule-item">
          <view class="rule-icon">👍</view>
          <view class="rule-info">
            <text class="rule-name">文章获赞</text>
            <text class="rule-points">+1 积分</text>
          </view>
        </view>
      </view>
      <view class="preview-footer">
        <text class="footer-link" bindtap="goToPointsRules">查看完整规则 ›</text>
      </view>
    </view>
  </view>

  <!-- 已登录状态 -->
  <scroll-view class="content" scroll-y wx:if="{{!loading && isLoggedIn && userInfo}}">
    <!-- 积分卡片 -->
    <view class="points-card">
      <view class="points-header">
        <text class="points-label">当前积分</text>
        <text class="points-value">{{userInfo.points || 0}}</text>
      </view>
      <view class="points-tip">
        <text>💡 每日登录可获得 5 积分</text>
      </view>
    </view>

    <!-- 快捷入口 -->
    <view class="quick-actions">
      <view class="action-item" bindtap="goToPointsLog">
        <view class="action-icon">📋</view>
        <text class="action-text">积分流水</text>
      </view>
      <view class="action-item" bindtap="goToPointsRules">
        <view class="action-icon">📖</view>
        <text class="action-text">积分规则</text>
      </view>
      <view class="action-item" bindtap="goToPointsMall">
        <view class="action-icon">🛒</view>
        <text class="action-text">积分商城</text>
      </view>
    </view>

    <!-- 最近记录 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">最近记录</text>
        <text class="section-more" bindtap="goToPointsLog">查看全部</text>
      </view>

      <view class="log-list" wx:if="{{recentLogs.length > 0}}">
        <view class="log-item card" wx:for="{{recentLogs}}" wx:key="id">
          <view class="log-info">
            <text class="log-reason">{{item.reasonText}}</text>
            <text class="log-time">{{formatTime(item.created_at)}}</text>
          </view>
          <text class="log-change {{item.change > 0 ? 'positive' : 'negative'}}">
            {{item.change > 0 ? '+' : ''}}{{item.change}}
          </text>
        </view>
      </view>

      <view class="empty-state" wx:else>
        <text>暂无积分记录</text>
      </view>
    </view>
  </scroll-view>
</view>
