/* pages/points/index.wxss */
.page {
  height: 100vh;
  background: #f6f7f9;
}

.content {
  height: 100%;
  padding: 32rpx;
}

/* 未登录状态 */
.not-logged-in {
  height: 100%;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.login-prompt {
  background: linear-gradient(135deg, #18a058 0%, #0d7a3f 100%);
  border-radius: 32rpx;
  padding: 64rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(24, 160, 88, 0.3);
}

.prompt-icon {
  font-size: 96rpx;
  margin-bottom: 16rpx;
}

.prompt-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #ffffff;
}

.prompt-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  text-align: center;
  line-height: 1.6;
}

.login-btn {
  margin-top: 16rpx;
  width: 320rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #ffffff;
  color: #18a058;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 40rpx;
  border: none;
  padding: 0;
}

.login-btn::after {
  border: none;
}

/* 规则预览 */
.rules-preview {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.preview-header {
  margin-bottom: 24rpx;
}

.preview-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}

.rule-items {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.rule-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  background: #f6f7f9;
  border-radius: 16rpx;
}

.rule-icon {
  font-size: 40rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.rule-info {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.rule-name {
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 500;
}

.rule-points {
  font-size: 28rpx;
  color: #18a058;
  font-weight: 600;
}

.preview-footer {
  text-align: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.footer-link {
  font-size: 26rpx;
  color: #18a058;
}

/* 积分卡片 */
.points-card {
  background: linear-gradient(135deg, #18a058 0%, #0d7a3f 100%);
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(24, 160, 88, 0.3);
}

.points-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.points-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 16rpx;
}

.points-value {
  font-size: 88rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1;
}

.points-tip {
  text-align: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 快捷入口 */
.quick-actions {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.action-item {
  flex: 1;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.action-icon {
  font-size: 48rpx;
}

.action-text {
  font-size: 26rpx;
  color: #374151;
  font-weight: 500;
}

/* 区块 */
.section {
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}

.section-more {
  font-size: 24rpx;
  color: #18a058;
}

/* 积分流水 */
.log-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.log-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
}

.log-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.log-reason {
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 500;
}

.log-time {
  font-size: 24rpx;
  color: #9ca3af;
}

.log-change {
  font-size: 36rpx;
  font-weight: 600;
}

.log-change.positive {
  color: #18a058;
}

.log-change.negative {
  color: #ef4444;
}

/* 加载状态 */
.loading-state {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9ca3af;
}

/* 空状态 */
.empty-state {
  padding: 80rpx 32rpx;
  text-align: center;
  color: #9ca3af;
}
