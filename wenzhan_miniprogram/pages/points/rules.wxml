<!--pages/points/rules.wxml-->
<view class="page">
  <scroll-view class="content" scroll-y>
    <!-- 页面标题 -->
    <view class="page-header">
      <text class="page-title">积分规则说明</text>
      <text class="page-desc">了解如何获取和使用积分</text>
    </view>

    <!-- 规则列表 -->
    <view class="rules-list">
      <view class="rule-section" wx:for="{{rules}}" wx:key="title">
        <view class="section-header">
          <text class="section-icon">{{item.icon}}</text>
          <text class="section-title">{{item.title}}</text>
        </view>

        <view class="rule-items">
          <view class="rule-item" wx:for="{{item.items}}" wx:key="action" wx:for-item="rule">
            <view class="rule-info">
              <text class="rule-action">{{rule.action}}</text>
              <text class="rule-limit">{{rule.limit}}</text>
            </view>
            <text class="rule-points" style="color: {{rule.color}}">{{rule.points}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 温馨提示 -->
    <view class="tips-section">
      <view class="tips-header">
        <text class="tips-icon">💡</text>
        <text class="tips-title">温馨提示</text>
      </view>
      <view class="tips-list">
        <view class="tip-item" wx:for="{{tips}}" wx:key="index">
          <text class="tip-dot">•</text>
          <text class="tip-text">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 底部说明 -->
    <view class="footer-note">
      <text>积分规则最终解释权归文栈博客所有</text>
    </view>
  </scroll-view>
</view>
