/* pages/points/orders.wxss */
.page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 状态标签 */
.tabs {
  display: flex;
  background-color: #fff;
  padding: 0 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 30rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #18a058;
  font-weight: 500;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: #18a058;
  border-radius: 3rpx;
}

/* 订单列表 */
.order-list {
  height: calc(100vh - 100rpx);
  padding: 20rpx;
}

.order-item {
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 订单头部 */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-no {
  font-size: 26rpx;
  color: #999;
}

.order-status {
  font-size: 26rpx;
  font-weight: 500;
}

.status-pending {
  color: #faad14;
}

.status-shipped {
  color: #1890ff;
}

.status-completed {
  color: #52c41a;
}

.status-cancelled {
  color: #999;
}

/* 商品信息 */
.order-goods {
  display: flex;
  padding: 30rpx;
}

.goods-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background-color: #f5f5f5;
  flex-shrink: 0;
}

/* 无图片占位符 */
.goods-image-placeholder {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #18a058;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  flex-shrink: 0;
}

.placeholder-text {
  font-size: 24rpx;
  font-weight: bold;
  color: #fff;
  text-align: center;
  line-height: 1.3;
  word-break: break-all;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.type-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  padding: 4rpx 8rpx;
  background-color: rgba(255, 255, 255, 0.9);
  color: #18a058;
  font-size: 20rpx;
  border-radius: 6rpx;
  font-weight: 500;
}

.goods-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.goods-meta {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.goods-type {
  padding: 6rpx 12rpx;
  background-color: #f0f0f0;
  color: #666;
  font-size: 22rpx;
  border-radius: 6rpx;
  margin-right: 16rpx;
}

.goods-quantity {
  font-size: 26rpx;
  color: #999;
}

.goods-points {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  margin-left: 20rpx;
}

.points-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff4d4f;
}

.points-unit {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 订单底部 */
.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.order-time {
  font-size: 24rpx;
  color: #999;
}

.action-link {
  font-size: 26rpx;
  color: #18a058;
}

/* 加载状态 */
.loading-more,
.no-more {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
