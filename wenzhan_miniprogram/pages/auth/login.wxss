/* pages/auth/login.wxss */
.page {
  position: relative;
  min-height: 100vh;
  background: linear-gradient(180deg, #f0fdf4 0%, #f6f7f9 42%, #ffffff 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 56rpx 32rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.decor {
  position: absolute;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: rgba(24, 160, 88, 0.1);
}

.decor-left {
  left: -180rpx;
  top: 80rpx;
}

.decor-right {
  right: -220rpx;
  bottom: 120rpx;
  background: rgba(13, 122, 63, 0.08);
}

.container {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 686rpx;
  box-sizing: border-box;
}

.brand-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
}

.logo-card {
  width: 112rpx;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #18a058;
  border-radius: 32rpx;
  box-shadow: 0 18rpx 42rpx rgba(24, 160, 88, 0.25);
  margin-bottom: 28rpx;
}

.logo-text {
  color: #ffffff;
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1;
}

.app-name {
  font-size: 48rpx;
  line-height: 58rpx;
  font-weight: 800;
  color: #111827;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.app-desc {
  font-size: 26rpx;
  line-height: 36rpx;
  color: #6b7280;
}

.panel {
  width: 100%;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(229, 231, 235, 0.9);
  border-radius: 36rpx;
  padding: 44rpx 36rpx;
  box-shadow: 0 20rpx 60rpx rgba(15, 23, 42, 0.08);
  box-sizing: border-box;
}

.panel-header {
  margin-bottom: 40rpx;
  text-align: center;
}

.panel-title {
  display: block;
  font-size: 40rpx;
  line-height: 50rpx;
  color: #111827;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.panel-subtitle {
  display: block;
  font-size: 26rpx;
  line-height: 38rpx;
  color: #6b7280;
}

.primary-btn {
  width: 100%;
  height: 96rpx;
  min-height: 96rpx;
  max-height: 96rpx;
  padding: 0;
  margin: 0;
  border: none;
  border-radius: 999rpx;
  background: #18a058;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 96rpx;
  box-shadow: 0 14rpx 32rpx rgba(24, 160, 88, 0.24);
  box-sizing: border-box;
  overflow: hidden;
}

.primary-btn::after {
  border: none;
}

.primary-btn[disabled] {
  opacity: 0.78;
  color: #ffffff;
  background: #18a058;
}

.primary-btn-hover {
  transform: translateY(2rpx);
  opacity: 0.92;
}

.wechat-login-btn {
  width: 100%;
}

.submit-btn {
  margin-top: 12rpx;
}

.btn-content {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  white-space: nowrap;
  box-sizing: border-box;
}

.btn-icon {
  display: inline-block;
  width: 34rpx;
  height: 34rpx;
  font-size: 32rpx;
  line-height: 34rpx;
  flex: 0 0 34rpx;
}

.btn-text {
  display: inline-block;
  max-width: 460rpx;
  font-size: 30rpx;
  line-height: 34rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.btn-loading {
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 32rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.45);
  border-top-color: #ffffff;
  box-sizing: border-box;
  animation: btnSpin 0.8s linear infinite;
}

.btn-loading.light {
  border-color: rgba(255, 255, 255, 0.45);
  border-top-color: #ffffff;
}

@keyframes btnSpin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.panel-footer {
  margin-top: 28rpx;
  text-align: center;
}

.tip-text {
  font-size: 24rpx;
  line-height: 34rpx;
  color: #6b7280;
}

.form-section {
  padding-top: 40rpx;
}

.form-header {
  display: flex;
  align-items: flex-start;
  margin-bottom: 36rpx;
}

.back-btn {
  flex: 0 0 auto;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 20rpx;
  margin-right: 20rpx;
  font-size: 26rpx;
  color: #18a058;
  background: #f0fdf4;
  border-radius: 999rpx;
}

.form-title-wrap {
  flex: 1;
  min-width: 0;
}

.form-title {
  display: block;
  font-size: 36rpx;
  line-height: 46rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 8rpx;
}

.form-subtitle {
  display: block;
  font-size: 24rpx;
  line-height: 34rpx;
  color: #6b7280;
}

.form-group {
  margin-bottom: 22rpx;
}

.form-input {
  width: 100%;
  height: 92rpx;
  min-height: 92rpx;
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 22rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #111827;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #18a058;
}

.captcha-group {
  margin-bottom: 24rpx;
}

.captcha-question {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
  padding: 0 4rpx;
}

.captcha-text {
  font-size: 28rpx;
  color: #111827;
  font-weight: 700;
}

.captcha-refresh {
  min-width: 96rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 24rpx;
  color: #18a058;
  background: #f0fdf4;
  border-radius: 999rpx;
}

.switch-type {
  margin-top: 30rpx;
  text-align: center;
}

.switch-text {
  font-size: 26rpx;
  line-height: 36rpx;
  color: #18a058;
  font-weight: 600;
}
