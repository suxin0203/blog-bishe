/* pages/index/index.wxss */
.page {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f6f7f9;
  overflow-x: hidden;
  box-sizing: border-box;
}

/* 自定义导航栏 */
.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  z-index: 1000;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.navbar-content {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 88rpx;
  padding: 0 32rpx;
}

.navbar-title {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  line-height: 1;
  white-space: nowrap;
}

.navbar-placeholder {
  width: 64rpx;
  height: 64rpx;
}

.navbar-search {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f4f6;
  border-radius: 32rpx;
}

.search-icon {
  font-size: 32rpx;
}

/* 内容区域 */
.content {
  flex: 1;
  overflow-y: auto;
}

/* 轮播图 */
.swiper-container {
  width: calc(100% - 64rpx);
  margin: 24rpx 32rpx;
  box-sizing: border-box;
}

.swiper {
  width: 100%;
  height: 320rpx;
  border-radius: 28rpx;
  overflow: hidden;
}

.swiper-item {
  position: relative;
  width: 100%;
  height: 100%;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

.swiper-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.7), transparent);
  color: #ffffff;
}

.swiper-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.swiper-desc {
  display: block;
  font-size: 24rpx;
  opacity: 0.9;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 区块 */
.section {
  width: 100%;
  margin-top: 24rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}

.section-more {
  font-size: 24rpx;
  color: #18a058;
}

/* 分类横向滚动 */
.category-section {
  margin-top: 16rpx;
}

.category-scroll {
  width: 100%;
  white-space: nowrap;
}

.category-scroll-content {
  display: block;
  white-space: nowrap;
  padding: 0 8rpx 8rpx;
}

.category-card {
  display: inline-block;
  width: auto;
  min-width: auto;
  margin-right: 16rpx;
  padding: 16rpx 28rpx;
  line-height: 26rpx;
  font-size: 26rpx;
  color: #1f2937;
  font-weight: 500;
  white-space: nowrap;
  background: #ffffff;
  border-radius: 999rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #e5e7eb;
  box-sizing: border-box;
  vertical-align: top;
  transition: all 0.3s ease;
}

.category-card:active {
  transform: scale(0.95);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.08);
}

/* 标签云 */
.tag-section {
  margin-top: 16rpx;
}

.tag-cloud {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-item {
  padding: 12rpx 24rpx;
  background: #f0fdf4;
  color: #18a058;
  font-size: 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid #18a05830;
  transition: all 0.3s ease;
}

.tag-item:active {
  transform: scale(0.95);
  background: #dcfce7;
}

/* 热门文章 */
.hot-list {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 16rpx 0;
}

.hot-item {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
}

.hot-rank {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.rank-1 {
  background: #fef3c7;
  color: #f59e0b;
}

.rank-2 {
  background: #dbeafe;
  color: #3b82f6;
}

.rank-3 {
  background: #fce7f3;
  color: #ec4899;
}

.rank-4, .rank-5 {
  background: #f3f4f6;
  color: #6b7280;
}

.hot-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.hot-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2937;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hot-meta {
  font-size: 24rpx;
  color: #9ca3af;
}

/* 文章列表 */
.article-list {
  margin-bottom: 32rpx;
}

.article-item {
  margin-bottom: 24rpx;
}

.article-with-cover {
  display: flex;
  gap: 24rpx;
}

.article-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.article-cover {
  width: 200rpx;
  height: 160rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.article-no-cover {
  display: flex;
  flex-direction: column;
}

.article-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  line-height: 1.5;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.article-summary {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.6;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.article-tags {
  margin-bottom: 16rpx;
}

.article-meta {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #9ca3af;
}

.meta-item {
  margin-right: 8rpx;
}

.meta-divider {
  margin-right: 8rpx;
}

/* 加载状态 */
.loading-more,
.no-more {
  padding: 32rpx;
  text-align: center;
  font-size: 24rpx;
  color: #9ca3af;
}
