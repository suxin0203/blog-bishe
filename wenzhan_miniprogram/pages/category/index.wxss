/* pages/category/index.wxss */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f6f7f9;
}

/* 标签页 */
.tabs {
  display: flex;
  background: #ffffff;
  padding: 0 32rpx;
}

.tab-item {
  flex: 1;
  padding: 32rpx 0;
  text-align: center;
  position: relative;
}

.tab-text {
  font-size: 30rpx;
  color: #6b7280;
  font-weight: 500;
}

.tab-item.active .tab-text {
  color: #18a058;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: #18a058;
  border-radius: 3rpx;
}

/* 内容区域 */
.content {
  flex: 1;
  padding: 32rpx;
}

/* 分类列表 */
.category-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.category-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.category-icon {
  font-size: 48rpx;
}

.category-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.category-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 8rpx;
}

.category-count {
  font-size: 24rpx;
  color: #9ca3af;
}

.category-arrow {
  font-size: 48rpx;
  color: #d1d5db;
}

/* 标签列表 */
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.tag-item {
  background: #ffffff;
  border-radius: 48rpx;
  padding: 20rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.tag-name {
  font-size: 28rpx;
  color: #18a058;
  font-weight: 500;
}

.tag-count {
  font-size: 24rpx;
  color: #9ca3af;
}
