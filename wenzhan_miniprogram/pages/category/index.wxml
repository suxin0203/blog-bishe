<!--pages/category/index.wxml-->
<view class="page">
  <!-- 标签页切换 -->
  <view class="tabs">
    <view class="tab-item {{activeTab === 0 ? 'active' : ''}}" bindtap="switchTab" data-index="0">
      <text class="tab-text">分类</text>
    </view>
    <view class="tab-item {{activeTab === 1 ? 'active' : ''}}" bindtap="switchTab" data-index="1">
      <text class="tab-text">标签</text>
    </view>
  </view>

  <!-- 分类列表 -->
  <scroll-view class="content" scroll-y wx:if="{{activeTab === 0}}">
    <view class="category-list">
      <view class="category-item card" wx:for="{{categories}}" wx:key="id" bindtap="goToCategoryArticles" data-id="{{item.id}}" data-name="{{item.name}}">
        <view class="category-icon">📁</view>
        <view class="category-info">
          <text class="category-name">{{item.name}}</text>
          <text class="category-count">{{item.article_count || 0}} 篇文章</text>
        </view>
        <text class="category-arrow">›</text>
      </view>
    </view>

    <view class="empty-state" wx:if="{{!loading && categories.length === 0}}">
      <text>暂无分类</text>
    </view>
  </scroll-view>

  <!-- 标签列表 -->
  <scroll-view class="content" scroll-y wx:if="{{activeTab === 1}}">
    <view class="tag-list">
      <view class="tag-item" wx:for="{{tags}}" wx:key="id" bindtap="goToTagArticles" data-id="{{item.id}}" data-name="{{item.name}}">
        <text class="tag-name">#{{item.name}}</text>
        <text class="tag-count">{{item.article_count || 0}}</text>
      </view>
    </view>

    <view class="empty-state" wx:if="{{!loading && tags.length === 0}}">
      <text>暂无标签</text>
    </view>
  </scroll-view>
</view>
