<!--pages/article/detail.wxml-->
<view class="page">
  <!-- 加载状态 -->
  <view class="loading-state" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 文章内容 -->
  <scroll-view class="content" scroll-y wx:if="{{!loading && article}}">
    <!-- 文章头部 -->
    <view class="article-header">
      <!-- 分类和标签 -->
      <view class="article-tags" wx:if="{{article.category_name || (article.tags && article.tags.length > 0)}}">
        <text class="tag tag-primary" wx:if="{{article.category_name}}">{{article.category_name}}</text>
        <text class="tag tag-secondary" wx:for="{{article.tags}}" wx:key="id">{{item.name}}</text>
      </view>

      <!-- 标题 -->
      <text class="article-title">{{article.title}}</text>

      <!-- 元信息 -->
      <view class="article-meta">
        <text class="meta-item">{{article.author_name || '匿名'}}</text>
        <text class="meta-divider">·</text>
        <text class="meta-item">{{formatTime(article.created_at)}}</text>
        <text class="meta-divider">·</text>
        <text class="meta-item">{{formatReadCount(article.views)}} 阅读</text>
      </view>
    </view>

    <!-- 封面图 -->
    <image class="article-cover" wx:if="{{article.cover_url || article.cover_image}}" src="{{article.cover_url || article.cover_image}}" mode="aspectFill" bindtap="previewImage" data-src="{{article.cover_url || article.cover_image}}" />

    <!-- 文章正文 -->
    <view class="article-body">
      <text class="article-text" decode="{{true}}">{{article.plainContent || '暂无内容'}}</text>
    </view>

    <!-- 评论区 -->
    <view class="comment-section">
      <view class="comment-header">
        <text class="comment-title">评论区</text>
        <text class="comment-count">{{comments.length}} 条评论</text>
      </view>

      <!-- 评论列表 -->
      <view class="comment-list" wx:if="{{comments.length > 0}}">
        <view class="comment-item" wx:for="{{comments}}" wx:key="id">
          <view class="comment-user">
            <text class="user-name">{{item.user_name || '匿名'}}</text>
            <text class="comment-time">{{formatTime(item.created_at)}}</text>
          </view>
          <text class="comment-content">{{item.content}}</text>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-comment" wx:else>
        <text>暂无评论，快来抢沙发吧~</text>
      </view>
    </view>
  </scroll-view>

  <!-- 底部操作栏 -->
  <view class="footer" wx:if="{{!loading && article}}">
    <!-- 评论输入 -->
    <view class="comment-input" bindtap="showCommentInput">
      <text class="input-placeholder">写评论...</text>
    </view>

    <!-- 互动按钮 -->
    <view class="action-buttons">
      <view class="action-btn" bindtap="handleLike">
        <text class="action-icon {{isLiked ? 'active' : ''}}">{{isLiked ? '❤️' : '🤍'}}</text>
      </view>
      <view class="action-btn" bindtap="handleFavorite">
        <text class="action-icon {{isFavorited ? 'active' : ''}}">{{isFavorited ? '⭐' : '☆'}}</text>
      </view>
    </view>
  </view>

  <!-- 评论弹窗 -->
  <view class="comment-modal" wx:if="{{showCommentInput}}">
    <view class="modal-mask" bindtap="cancelComment"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">发表评论</text>
        <text class="modal-close" bindtap="cancelComment">✕</text>
      </view>
      <textarea class="comment-textarea" placeholder="说点什么..." value="{{commentContent}}" bindinput="onCommentInput" auto-focus maxlength="500" />
      <view class="modal-footer">
        <text class="char-count">{{commentContent.length}}/500</text>
        <button class="submit-btn" bindtap="submitComment">发表</button>
      </view>
    </view>
  </view>
</view>
