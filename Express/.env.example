# 复制为 .env 并填入真实值；.env 已被 git 忽略，不会入库
DB_HOST=127.0.0.1
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=wztest

# JWT 签名密钥（common/jwt.js 读取）
JWT_SECRET=change_me_to_a_long_random_string

# 微信小程序（services/wechatMiniService.js 读取）
WX_MINIAPP_APPID=your_wx_appid
WX_MINIAPP_SECRET=your_wx_secret

# AI 向导（智谱 BigModel https://open.bigmodel.cn 申请，flash 系列模型免费）
ZHIPU_API_KEY=
